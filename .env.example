# Database Connection:
# Production & Docker: PostgreSQL 16
DATABASE_URL=postgresql://meridian:meridian_secret@localhost:5432/meridian_db

# Local Development Fallback (SQLite):
# Note: SQLite does not enforce row-level locking (SELECT ... FOR UPDATE).
# DATABASE_URL=sqlite:///./meridian.db

# JWT Authentication
JWT_SECRET=meridian_secret_super_key_jwt_auth_production_grade_token_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
ECHO_SQL=false

