# ==============================================================================
# MERIDIAN British Auction RFQ Procurement Exchange - Environment Variables
# ==============================================================================

# Database Connection:
# Production & Docker: PostgreSQL 16
DATABASE_URL=postgresql://meridian_user:meridian_secure_password@localhost:5432/meridian_db

# Local Development Fallback (SQLite):
# Note: SQLite serializes writes at the file level and does not support true row-level locking.
# DATABASE_URL=sqlite:///./meridian.db

# JWT Authentication
# Secret key used to sign access tokens (min 32 characters)
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Security & CORS
# Comma-separated list of permitted origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:5173
ECHO_SQL=false
